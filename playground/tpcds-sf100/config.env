# Paths are evaluated by the host-side launch scripts.
TPCDS_SCALE_FACTOR=100
TPCDS_DATA_DIR=data/sf100-parquet-zstd
TPCDS_QUERY_DIR=../../tools/gluten-it/common/src/main/resources/tpcds-queries
GLUTEN_JAR=../../package/target/gluten-velox-bundle-spark3.5_2.12-linux_amd64-1.8.0-SNAPSHOT.jar

TPCDS_IMAGE=gluten-cudf-spark35:tpcds
SPARK_MASTER=local[4]
SPARK_DRIVER_MEMORY=4g
SPARK_OFFHEAP_SIZE=6g
SPARK_LOCAL_DIR=runtime/spark-local
TPCDS_GENERATION_PARTITIONS=32
TPCDS_SHUFFLE_PARTITIONS=32

# A generation run needs room for the final data and temporary shuffle files.
TPCDS_MIN_FREE_GIB=80

# Conservative defaults for the 23 GiB NVIDIA L4 used during development.
CUDF_CONCURRENT_GPU_TASKS=1
CUDF_MEMORY_PERCENT=50
